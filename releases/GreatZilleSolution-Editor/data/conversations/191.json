n nodded smoothly.", "menuText": "", "conditions": "", "userScript": "", "outgoing": [82], "isPlayer": false, "isRoot": 0}, {"id": 52, "actorId": 38, "speaker": "Lucian Galade", "title": "Lucian Galade: \"\"*If* you did such a thing, you sho...\"", "dialogueText": "\"*If* you did such a thing, you should never have proceeded with this investigation. Once Mrs. Morgna hears about the bribe, she's never going to let it go.\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [33], "isPlayer": false, "isRoot": 0}, {"id": 53, "actorId": 38, "speaker": "Lucian Galade", "title": "Lucian Galade: \"\"Sir, did you accept a bribe from M...\"", "dialogueText": "\"Sir, did you accept a bribe from Mr. Tusk at the beginning of your term?\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [81, 50, 66], "isPlayer": false, "isRoot": 0}, {"id": 54, "actorId": 38, "speaker": "Lucian Galade", "title": "Lucian Galade: \"\"Yes, given the constraints of the...\"", "dialogueText": "\"Yes, given the constraints of the Anti-Corruption Police, we could only succeed in extending his sentence.\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [70], "isPlayer": false, "isRoot": 0}, {"id": 55, "actorId": 38, "speaker": "Lucian Galade", "title": "Lucian Galade: \"\"I'll make some phone calls, sir.\"\"", "dialogueText": "\"I'll make some phone calls, sir.\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [22], "isPlayer": false, "isRoot": 0}, {"id": 56, "actorId": 38, "speaker": "Lucian Galade", "title": "Lucian Galade: \"\"Very well, sir.\"\"", "dialogueText": "\"Very well, sir.\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [2], "isPlayer": false, "isRoot": 0}, {"id": 57, "actorId": 2, "speaker": "Paskal Beniwoll", "title": "BaseGame.Turn05_SnO_LE_Policy_AntiCorruptionPolice == true", "dialogueText": "", "menuText": "", "conditions": "", "userScript": "", "outgoing": [58, 59], "isPlayer": false, "isRoot": 0}, 