{"id": 408, "title": "Rizia/Turn 8/NOTES_CONSTITION FINALIZED", "description": "", "pack": "Rizia", "folder": "Turn_08", "turn": "Tura 08", "modStatus": "VANILLA", "modNote": "", "actors": ["Manus Sazon", "Narrator", "Player_Romus"], "readVariables": ["RiziaDLC.Reform_Diplomatic", "RiziaDLC.Reform_Movement_Leader_Adarfo", "RiziaDLC.Reform_Regions_Centralized", "RiziaDLCIsolated.Reform_Intention_Legislative_Unicameral", "RiziaDLCIsolated.Reform_Intention_Regions_Centralize"], "writtenVariables": ["RiziaDLC.Reform_Judiciary_Immunity", "RiziaDLC.Reform_Judiciary_JudicialReview", "RiziaDLC.Reform_Judiciary_LifeTenure", "RiziaDLC.Reform_Judiciary_NoConstitutionalCourt", "RiziaDLC.Reform_Legislative_HouseOfLords", "RiziaDLC.Reform_Legislative_RegionalSenate", "RiziaDLC.Reform_Regions_Centralized", "RiziaDLC.Reform_UpperHouse_Advisory", "RiziaDLC.Reform_UpperHouse_Equal", "RiziaDLC.Reform_UpperHouse_Limited", "RiziaDLC.Situation_Order_AutonomousProvincialPolicing_None", "RiziaDLC.Situation_Order_AutonomousProvincialPolicing_Some", "RiziaDLCSupport.Journal_Turn08_ReformManus_CentralizeRegions", "RiziaDLCSupport.Journal_Turn08_ReformManus_HouseOfLords", "RiziaDLCSupport.Journal_Turn08_ReformManus_JudicialReview", "RiziaDLCSupport.Journal_Turn08_ReformManus_JudiciaryImmunity", "RiziaDLCSupport.Journal_Turn08_ReformManus_LifeTenure", "RiziaDLCSupport.Journal_Turn08_ReformManus_NoConstitutionalCourt", "RiziaDLCSupport.Journal_Turn08_ReformManus_RegionSenate", "RiziaDLCSupport.Journal_Turn08_ReformManus_UpperHouseAdvisorary", "RiziaDLCSupport.Journal_Turn08_ReformManus_UpperHouseEqual", "RiziaDLCSupport.Journal_Turn08_ReformManus_UpperHouseLimited"], "choicesCount": 22, "entriesCount": 78, "entries": [{"id": 0, "actorId": 1, "speaker": "START", "title": "START", "dialogueText": "", "menuText": "", "conditions": "", "userScript": "", "outgoing": [1], "isPlayer": false, "isRoot": 0}, {"id": 1, "actorId": 2, "speaker": "INPUT", "title": "input", "dialogueText": "", "menuText": "", "conditions": "", "userScript": "", "outgoing": [], "isPlayer": false, "isRoot": 0}, {"id": 3, "actorId": 2, "speaker": "Paskal Beniwoll", "title": "RiziaDLC.Reform_Movement_Leader_Adarfo == true", "dialogueText": "", "menuText": "", "conditions": "", "userScript": "", "outgoing": [4, 5], "isPlayer": false, "isRoot": 0}, {"id": 4, "actorId": 2, "speaker": "Paskal Beniwoll", "title": "RiziaDLC.Reform_Movement_Leader_Adarfo == true", "dialogueText": "", "menuText": "", "conditions": "Variable[\"RiziaDLC.Reform_Movement_Leader_Adarfo\"] == true", "userScript": "", "outgoing": [31], "isPlayer": false, "isRoot": 0}, {"id": 5, "actorId": 2, "speaker": "Paskal Beniwoll", "title": "!(RiziaDLC.Reform_Movement_Leader_Adarfo == true)", "dialogueText": "", "menuText": "", "conditions": "(Variable[\"RiziaDLC.Reform_Movement_Leader_Adarfo\"] == true) == false", "userScript": "", "outgoing": [60], "isPlayer": false, "isRoot": 0}, {"id": 6, "actorId": 75, "speaker": "Manus Sazon", "title": "Manus Sazon: \"\"How about the legislative? You men...\"", "dialogueText": "\"How about the legislative? You mentioned establishing an upper house. How would that be structured?\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [18, 13, 14], "isPlayer": false, "isRoot": 0}, {"id": 7, "actorId": 95, "speaker": "Player_Romus", "title": "Player_Romus: \"\"I've changed my mind. We will esta...\"", "dialogueText": "\"I've changed my mind. We will establish a House of Lords comprised of the nobility as an upper house to get the nobility's backing.\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [10], "isPlayer": true, "isRoot": 0}, {"id": 8, "actorId": 95, "speaker": "Player_Romus", "title": "Player_Romus: \"\"Yes. House of Delegates will be th...\"", "dialogueText": "\"Yes. House of Delegates will be the sole legislative body in the country.\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [20], "isPlayer": true, "isRoot": 0}, {"id": 9, "actorId": 75, "speaker": "Manus Sazon", "title": "Manus Sazon: \"\"And how would the upper house be s...\"", "dialogueText": "\"And how would the upper house be structured?\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [13, 17], "isPlayer": false, "isRoot": 0}, {"id": 10, "actorId": 2, "speaker": "Paskal Beniwoll", "title": "RiziaDLC.Reform_Legislative_HouseOfLords = true;\nRiziaDLCSupport.Journal_Turn08_ReformManus_HouseOfLords = true;", "dialogueText": "", "menuText": "", "conditions": "", "userScript": "Variable[\"RiziaDLC.Reform_Legislative_HouseOfLords\"] = true;\nVariable[\"RiziaDLCSupport.Journal_Turn08_ReformManus_HouseOfLords\"] = true;", "outgoing": [19], "isPlayer": false, "isRoot": 0}, {"id": 11, "actorId": 2, "speaker": "Paskal Beniwoll", "title": "RiziaDLC.Reform_Legislative_RegionalSenate = true;\nRiziaDLCSupport.Journal_Turn08_ReformManus_RegionSenate = true;", "dialogueText": "", "menuText": "", "conditions": "", "userScript": "Variable[\"RiziaDLC.Reform_Legislative_RegionalSenate\"] = true;\nVariable[\"RiziaDLCSupport.Journal_Turn08_ReformManus_RegionSenate\"] = true;", "outgoing": [19], "isPlayer": false, "isRoot": 0}, {"id": 12, "actorId": 95, "speaker": "Player_Romus", "title": "Player_Romus: \"\"I've changed my mind. We may need...\"", "dialogueText": "\"I've changed my mind. We may need to establish an upper house that would provide checks and balances on the legislative branch.\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [9], "isPlayer": true, "isRoot": 0}, {"id": 13, "actorId": 95, "speaker": "Player_Romus", "title": "Player_Romus: \"\"We will establish a House of Lords...\"", "dialogueText": "\"We will establish a House of Lords comprised of the nobility as an upper house to get the nobility's backing.\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [10], "isPlayer": true, "isRoot": 0}, {"id": 14, "actorId": 2, "speaker": "Paskal Beniwoll", "title": "RiziaDLC.Reform_Regions_Centralized == true", "dialogueText": "", "menuText": "", "conditions": "", "userScript": "", "outgoing": [15, 16], "isPlayer": false, "isRoot": 0}, {"id": 15, "actorId": 2, "speaker": "Paskal Beniwoll", "title": "RiziaDLC.Reform_Regions_Centralized == true", "dialogueText": "", "menuText": "", "conditions": "Variable[\"RiziaDLC.Reform_Regions_Centralized\"] == true", "userScript": "", "outgoing": [], "isPlayer": false, "isRoot": 0}, {"id": 16, "actorId": 2, "speaker": "Paskal Beniwoll", "title": "!(RiziaDLC.Reform_Regions_Centralized == true)", "dialogueText": "", "menuText": "", "conditions": "(Variable[\"RiziaDLC.Reform_Regions_Centralized\"] == true) == false", "userScript": "", "outgoing": [17], "isPlayer": false, "isRoot": 0}, {"id": 17, "actorId": 95, "speaker": "Player_Romus", "title": "Player_Romus: \"\"We will establish a Senate compris...\"", "dialogueText": "\"We will establish a Senate comprised of elected senators from each region as an upper house.\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [11], "isPlayer": true, "isRoot": 0}, {"id": 18, "actorId": 95, "speaker": "Player_Romus", "title": "Player_Romus: \"\"Maybe it's not the best idea. We w...\"", "dialogueText": "\"Maybe it's not the best idea. We will keep the House of Delegates as the sole legislative body.\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [20], "isPlayer": true, "isRoot": 0}, {"id": 19, "actorId": 10, "speaker": "Narrator", "title": "Narrator: \"He kept taking notes as I spoke.\"", "dialogueText": "He kept taking notes as I spoke.", "menuText": "", "conditions": "", "userScript": "", "outgoing": [21, 22, 51], "isPlayer": false, "isRoot": 0}, {"id": 20, "actorId": 75, "speaker": "Manus Sazon", "title": "Manus Sazon: \"\"I understand.\"\"", "dialogueText": "\"I understand.\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [24], "isPlayer": false, "isRoot": 0}, {"id": 21, "actorId": 95, "speaker": "Player_Romus", "title": "Player_Romus: \"\"They won't have the authority to i...\"", "dialogueText": "\"They won't have the authority to initiate any legislation. They will only have limited legislative powers, such as voting on constitutional amendments and advising the lower house.\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [23], "isPlayer": true, "isRoot": 0}, {"id": 22, "actorId": 95, "speaker": "Player_Romus", "title": "Player_Romus: \"\"Both houses will vote on legislati...\"", "dialogueText": "\"Both houses will vote on legislation and approval of both will be required for enacting new laws. We will exercise equal bicameralism.\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [54], "isPlayer": true, "isRoot": 0}, {"id": 23, "actorId": 2, "speaker": "Paskal Beniwoll", "title": "RiziaDLC.Reform_UpperHouse_Advisory = true;\nRiziaDLCSupport.Journal_Turn08_ReformManus_UpperHouseAdvisorary = true;", "dialogueText": "", "menuText": "", "conditions": "", "userScript": "Variable[\"RiziaDLC.Reform_UpperHouse_Advisory\"] = true;\nVariable[\"RiziaDLCSupport.Journal_Turn08_ReformManus_UpperHouseAdvisorary\"] = true;", "outgoing": [20], "isPlayer": false, "isRoot": 0}, {"id": 24, "actorId": 75, "speaker": "Manus Sazon", "title": "Manus Sazon: \"\"And the judiciary?\"\"", "dialogueText": "\"And the judiciary?\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [58, 55, 25, 53, 61], "isPlayer": false, "isRoot": 0}, {"id": 25, "actorId": 95, "speaker": "Player_Romus", "title": "Player_Romus: \"\"We will grant them life tenure, wh...\"", "dialogueText": "\"We will grant them life tenure, which would free them from the pressure of protecting powerful interests or deciding according to momentary populism.\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [56], "isPlayer": true, "isRoot": 0}, {"id": 26, "actorId": 2, "speaker": "Paskal Beniwoll", "title": "RiziaDLC.Reform_Judiciary_Immunity = true;\nRiziaDLCSupport.Journal_Turn08_ReformManus_JudiciaryImmunity = true;", "dialogueText": "", "menuText": "", "conditions": "", "userScript": "Variable[\"RiziaDLC.Reform_Judiciary_Immunity\"] = true;\nVariable[\"RiziaDLCSupport.Journal_Turn08_ReformManus_JudiciaryImmunity\"] = true;", "outgoing": [27], "isPlayer": false, "isRoot": 0}, {"id": 27, "actorId": 10, "speaker": "Narrator", "title": "Narrator: \"He took notes.\"", "dialogueText": "He took notes.", "menuText": "", "conditions": "", "userScript": "", "outgoing": [57], "isPlayer": false, "isRoot": 0}, {"id": 28, "actorId": 2, "speaker": "Paskal Beniwoll", "title": "RiziaDLC.Reform_Diplomatic == true", "dialogueText": "", "menuText": "", "conditions": "", "userScript": "", "outgoing": [29, 30], "isPlayer": false, "isRoot": 0}, {"id": 29, "actorId": 2, "speaker": "Paskal Beniwoll", "title": "RiziaDLC.Reform_Diplomatic == true", "dialogueText": "", "menuText": "", "conditions": "Variable[\"RiziaDLC.Reform_Diplomatic\"] == true", "userScript": "", "outgoing": [], "isPlayer": false, "isRoot": 0}, {"id": 30, "actorId": 2, "speaker": "Paskal Beniwoll", "title": "!(RiziaDLC.Reform_Diplomatic == true)", "dialogueText": "", "menuText": "", "conditions": "(Variable[\"RiziaDLC.Reform_Diplomatic\"] == true) == false", "userScript": "", "outgoing": [], "isPlayer": false, "isRoot": 0}, {"id": 31, "actorId": 75, "speaker": "Manus Sazon", "title": "Manus Sazon: \"\"I'll get to work on the draft. Mr....\"", "dialogueText": "\"I'll get to work on the draft. Mr. Sotelato will take care of rallying the movement.\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [28], "isPlayer": false, "isRoot": 0}, {"id": 32, "actorId": 75, "speaker": "Manus Sazon", "title": "Manus Sazon: \"\"We are going to work on centralizi...\"", "dialogueText": "\"We are going to work on centralizing the system and abolish the regional structure, yes?\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [37, 62], "isPlayer": false, "isRoot": 0}, {"id": 33, "actorId": 2, "speaker": "Paskal Beniwoll", "title": "RiziaDLCIsolated.Reform_Intention_Regions_Centralize ==  true", "dialogueText": "", "menuText": "", "conditions": "", "userScript": "", "outgoing": [34, 35], "isPlayer": false, "isRoot": 0}, {"id": 34, "actorId": 2, "speaker": "Paskal Beniwoll", "title": "RiziaDLCIsolated.Reform_Intention_Regions_Centralize ==  true", "dialogueText": "", "menuText": "", "conditions": "Variable[\"RiziaDLCIsolated.Reform_Intention_Regions_Centralize\"] ==  true", "userScript": "", "outgoing": [32], "isPlayer": false, "isRoot": 0}, {"id": 35, "actorId": 2, "speaker": "Paskal Beniwoll", "title": "!(RiziaDLCIsolated.Reform_Intention_Regions_Centralize ==  true)", "dialogueText": "", "menuText": "", "conditions": "(Variable[\"RiziaDLCIsolated.Reform_Intention_Regions_Centralize\"] ==  true) == false", "userScript": "", "outgoing": [36], "isPlayer": false, "isRoot": 0}, {"id": 36, "actorId": 75, "speaker": "Manus Sazon", "title": "Manus Sazon: \"\"We are going to keep the federal s...\"", "dialogueText": "\"We are going to keep the federal structure and respect the autonomy of the regions, yes?\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [39, 40], "isPlayer": false, "isRoot": 0}, {"id": 37, "actorId": 95, "speaker": "Player_Romus", "title": "Player_Romus: \"\"Yes. We will centralize the system...\"", "dialogueText": "\"Yes. We will centralize the system completely.\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [41], "isPlayer": true, "isRoot": 0}, {"id": 38, "actorId": 95, "speaker": "Player_Romus", "title": "Player_Romus: \"\"I've changed my mind after our dis...\"", "dialogueText": "\"I've changed my mind after our discussion. Centralization will cost us much needed support. We'll respect the regions to get their vote.\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [42], "isPlayer": true, "isRoot": 0}, {"id": 39, "actorId": 95, "speaker": "Player_Romus", "title": "Player_Romus: \"\"Yes. We will respect the current s...\"", "dialogueText": "\"Yes. We will respect the current structure.\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [42], "isPlayer": true, "isRoot": 0}, {"id": 40, "actorId": 95, "speaker": "Player_Romus", "title": "Player_Romus: \"\"I've changed my mind after our dis...\"", "dialogueText": "\"I've changed my mind after our discussion. Rizia is too small of a country to require a complicated regional system. I don't want to transition into a weak and inefficient democracy. We'll centralize the structure.\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [41], "isPlayer": true, "isRoot": 0}, {"id": 41, "actorId": 2, "speaker": "Paskal Beniwoll", "title": "RiziaDLC.Reform_Regions_Centralized = true;\nRiziaDLCSupport.Journal_Turn08_ReformManus_CentralizeRegions = true;\nRiziaDLC.Situation_Order_AutonomousProvincialPolicing_Some = false;\nRiziaDLC.Situation_Order_AutonomousProvincialPolicing_None = true;", "dialogueText": "", "menuText": "", "conditions": "", "userScript": "Variable[\"RiziaDLC.Reform_Regions_Centralized\"] = true;\nVariable[\"RiziaDLCSupport.Journal_Turn08_ReformManus_CentralizeRegions\"] = true;\nVariable[\"RiziaDLC.Situation_Order_AutonomousProvincialPolicing_Some\"] = false;\nVariable[\"RiziaDLC.Situation_Order_AutonomousProvincialPolicing_None\"] = true;", "outgoing": [42], "isPlayer": false, "isRoot": 0}, {"id": 42, "actorId": 10, "speaker": "Narrator", "title": "Narrator: \"He took notes.\"", "dialogueText": "He took notes.", "menuText": "", "conditions": "", "userScript": "", "outgoing": [74], "isPlayer": false, "isRoot": 0}, {"id": 43, "actorId": 75, "speaker": "Manus Sazon", "title": "Manus Sazon: \"\"How about the House of Delegates?...\"", "dialogueText": "\"How about the House of Delegates? Are we keeping the legislative unicameral as mentioned before?\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [8, 47], "isPlayer": false, "isRoot": 0}, {"id": 44, "actorId": 2, "speaker": "Paskal Beniwoll", "title": "RiziaDLCIsolated.Reform_Intention_Legislative_Unicameral == true", "dialogueText": "", "menuText": "", "conditions": "", "userScript": "", "outgoing": [45, 46], "isPlayer": false, "isRoot": 0}, {"id": 45, "actorId": 2, "speaker": "Paskal Beniwoll", "title": "RiziaDLCIsolated.Reform_Intention_Legislative_Unicameral == true", "dialogueText": "", "menuText": "", "conditions": "Variable[\"RiziaDLCIsolated.Reform_Intention_Legislative_Unicameral\"] == true", "userScript": "", "outgoing": [43], "isPlayer": false, "isRoot": 0}, {"id": 46, "actorId": 2, "speaker": "Paskal Beniwoll", "title": "!(RiziaDLCIsolated.Reform_Intention_Legislative_Unicameral == true)", "dialogueText": "", "menuText": "", "conditions": "(Variable[\"RiziaDLCIsolated.Reform_Intention_Legislative_Unicameral\"] == true) == false", "userScript": "", "outgoing": [6], "isPlayer": false, "isRoot": 0}, {"id": 47, "actorId": 2, "speaker": "Paskal Beniwoll", "title": "RiziaDLC.Reform_Regions_Centralized == true && RiziaDLC.Reform_Diplomatic == true", "dialogueText": "", "menuText": "", "conditions": "", "userScript": "", "outgoing": [48, 49], "isPlayer": false, "isRoot": 0}, {"id": 48, "actorId": 2, "speaker": "Paskal Beniwoll", "title": "RiziaDLC.Reform_Regions_Centralized == true && RiziaDLC.Reform_Diplomatic == true", "dialogueText": "", "menuText": "", "conditions": "Variable[\"RiziaDLC.Reform_Regions_Centralized\"] == true  and  Variable[\"RiziaDLC.Reform_Diplomatic\"] == true", "userScript": "", "outgoing": [7], "isPlayer": false, "isRoot": 0}, {"id": 49, "actorId": 2, "speaker": "Paskal Beniwoll", "title": "!(RiziaDLC.Reform_Regions_Centralized == true && RiziaDLC.Reform_Diplomatic == true)", "dialogueText": "", "menuText": "", "conditions": "(Variable[\"RiziaDLC.Reform_Regions_Centralized\"] == true  and  Variable[\"RiziaDLC.Reform_Diplomatic\"] == true) == false", "userScript": "", "outgoing": [12], "isPlayer": false, "isRoot": 0}, {"id": 50, "actorId": 2, "speaker": "Paskal Beniwoll", "title": "RiziaDLC.Reform_Judiciary_NoConstitutionalCourt = true;\nRiziaDLCSupport.Journal_Turn08_ReformManus_NoConstitutionalCourt = true;", "dialogueText": "", "menuText": "", "conditions": "", "userScript": "Variable[\"RiziaDLC.Reform_Judiciary_NoConstitutionalCourt\"] = true;\nVariable[\"RiziaDLCSupport.Journal_Turn08_ReformManus_NoConstitutionalCourt\"] = true;", "outgoing": [27], "isPlayer": false, "isRoot": 0}, {"id": 51, "actorId": 95, "speaker": "Player_Romus", "title": "Player_Romus: \"\"They will have limited authority o...\"", "dialogueText": "\"They will have limited authority over legislation with the power to vote, and reject unconstitutional proposals and return them back to the lower house to be amended. However, the lower house should be able to bypass their veto.\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [52], "isPlayer": true, "isRoot": 0}, {"id": 52, "actorId": 2, "speaker": "Paskal Beniwoll", "title": "RiziaDLC.Reform_UpperHouse_Limited = true;\nRiziaDLCSupport.Journal_Turn08_ReformManus_UpperHouseLimited = true;", "dialogueText": "", "menuText": "", "conditions": "", "userScript": "Variable[\"RiziaDLC.Reform_UpperHouse_Limited\"] = true;\nVariable[\"RiziaDLCSupport.Journal_Turn08_ReformManus_UpperHouseLimited\"] = true;", "outgoing": [20], "isPlayer": false, "isRoot": 0}, {"id": 53, "actorId": 95, "speaker": "Player_Romus", "title": "Player_Romus: \"\"We will grant them the power of ju...\"", "dialogueText": "\"We will grant them the power of judicial review and to declare laws unconstitutional, so that they can keep the legislative and the executive in check.\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [59], "isPlayer": true, "isRoot": 0}, {"id": 54, "actorId": 2, "speaker": "Paskal Beniwoll", "title": "RiziaDLC.Reform_UpperHouse_Equal = true;\nRiziaDLCSupport.Journal_Turn08_ReformManus_UpperHouseEqual = true;", "dialogueText": "", "menuText": "", "conditions": "", "userScript": "Variable[\"RiziaDLC.Reform_UpperHouse_Equal\"] = true;\nVariable[\"RiziaDLCSupport.Journal_Turn08_ReformManus_UpperHouseEqual\"] = true;", "outgoing": [20], "isPlayer": false, "isRoot": 0}, {"id": 55, "actorId": 95, "speaker": "Player_Romus", "title": "Player_Romus: \"\"We will give the justices immunity...\"", "dialogueText": "\"We will give the justices immunity so that they cannot be threatened by powerful interests or the acting executive.\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [26], "isPlayer": true, "isRoot": 0}, {"id": 56, "actorId": 2, "speaker": "Paskal Beniwoll", "title": "RiziaDLC.Reform_Judiciary_LifeTenure = true;\nRiziaDLCSupport.Journal_Turn08_ReformManus_LifeTenure = true;", "dialogueText": "", "menuText": "", "conditions": "", "userScript": "Variable[\"RiziaDLC.Reform_Judiciary_LifeTenure\"] = true;\nVariable[\"RiziaDLCSupport.Journal_Turn08_ReformManus_LifeTenure\"] = true;", "outgoing": [27], "isPlayer": false, "isRoot": 0}, {"id": 57, "actorId": 75, "speaker": "Manus Sazon", "title": "Manus Sazon: \"\"Your Majesty. I think we've achiev...\"", "dialogueText": "\"Your Majesty. I think we've achieved a lot today.\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [3], "isPlayer": false, "isRoot": 0}, {"id": 58, "actorId": 95, "speaker": "Player_Romus", "title": "Player_Romus: \"\"There will be no constitutional co...\"", "dialogueText": "\"There will be no constitutional court and the judiciary will not have any political powers.\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [50], "isPlayer": true, "isRoot": 0}, {"id": 59, "actorId": 2, "speaker": "Paskal Beniwoll", "title": "RiziaDLC.Reform_Judiciary_JudicialReview = true;\nRiziaDLCSupport.Journal_Turn08_ReformManus_JudicialReview = true;", "dialogueText": "", "menuText": "", "conditions": "", "userScript": "Variable[\"RiziaDLC.Reform_Judiciary_JudicialReview\"] = true;\nVariable[\"RiziaDLCSupport.Journal_Turn08_ReformManus_JudicialReview\"] = true;", "outgoing": [27], "isPlayer": false, "isRoot": 0}, {"id": 60, "actorId": 75, "speaker": "Manus Sazon", "title": "Manus Sazon: \"\"I'll get to work on the draft. And...\"", "dialogueText": "\"I'll get to work on the draft. And I'll begin rallying the movement as soon as possible.\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [28], "isPlayer": false, "isRoot": 0}, {"id": 61, "actorId": 95, "speaker": "Player_Romus", "title": "Player_Romus: \"\"I don't want a strong judicial bra...\"", "dialogueText": "\"I don't want a strong judicial branch. We should retain some control over their composition.\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [27], "isPlayer": true, "isRoot": 0}, {"id": 62, "actorId": 2, "speaker": "Paskal Beniwoll", "title": "RiziaDLC.Reform_Diplomatic == true", "dialogueText": "", "menuText": "", "conditions": "", "userScript": "", "outgoing": [63, 64], "isPlayer": false, "isRoot": 0}, {"id": 63, "actorId": 2, "speaker": "Paskal Beniwoll", "title": "RiziaDLC.Reform_Diplomatic == true", "dialogueText": "", "menuText": "", "conditions": "Variable[\"RiziaDLC.Reform_Diplomatic\"] == true", "userScript": "", "outgoing": [38], "isPlayer": false, "isRoot": 0}, {"id": 64, "actorId": 2, "speaker": "Paskal Beniwoll", "title": "!(RiziaDLC.Reform_Diplomatic == true)", "dialogueText": "", "menuText": "", "conditions": "(Variable[\"RiziaDLC.Reform_Diplomatic\"] == true) == false", "userScript": "", "outgoing": [73], "isPlayer": false, "isRoot": 0}, {"id": 65, "actorId": 2, "speaker": "Paskal Beniwoll", "title": "RiziaDLCIsolated.Reform_Intention_Legislative_Unicameral == true", "dialogueText": "", "menuText": "", "conditions": "", "userScript": "", "outgoing": [66, 67], "isPlayer": false, "isRoot": 0}, {"id": 66, "actorId": 2, "speaker": "Paskal Beniwoll", "title": "RiziaDLCIsolated.Reform_Intention_Legislative_Unicameral == true", "dialogueText": "", "menuText":