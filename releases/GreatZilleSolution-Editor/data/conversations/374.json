{"id": 374, "title": "Rizia/Turn 6/Outro", "description": "Outro speech and section to end.", "pack": "Rizia", "folder": "Turn_06", "turn": "Tura 06", "modStatus": "VANILLA", "modNote": "", "actors": ["Hugo Toras", "Narrator", "Player_Romus", "Player_Romus_Italic", "Princess Vina", "Queen Mother Estela"], "readVariables": ["RiziaDLC.Trait_ReligiousKing", "RiziaDLC.Turn06_WarSpeech_EntireFamily", "RiziaDLC.Turn06_WarSpeech_Estela", "RiziaDLC.Turn06_WarSpeech_Hugo", "RiziaDLC.Turn06_WarSpeech_Impact", "RiziaDLC.Turn06_WarSpeech_RomusAlone", "RiziaDLC.Turn06_WarSpeech_Vina", "RiziaDLC.Vina_Hostage"], "writtenVariables": ["RiziaDLC.Said_GlovuriusAxaRizia", "RiziaDLC.Said_Halaita", "RiziaDLC.Turn06_WarSpeech_EntireFamilyHighlighted", "RiziaDLC.Turn06_WarSpeech_HugoHiglighted", "RiziaDLC.Turn06_WarSpeech_Impact", "RiziaDLC.Turn06_WarSpeech_MotherEstelaHighlighted", "RiziaDLC.Turn06_WarSpeech_RomusAloneHighlighted", "RiziaDLC.Turn06_WarSpeech_VinaHighlighted"], "choicesCount": 40, "entriesCount": 107, "entries": [{"id": 0, "actorId": 1, "speaker": "START", "title": "START", "dialogueText": "", "menuText": "", "conditions": "", "userScript": "", "outgoing": [1], "isPlayer": false, "isRoot": 0}, {"id": 1, "actorId": 2, "speaker": "INPUT", "title": "input", "dialogueText": "", "menuText": "", "conditions": "", "userScript": "", "outgoing": [29], "isPlayer": false, "isRoot": 0}, {"id": 2, "actorId": 2, "speaker": "OUTPUT", "title": "output", "dialogueText": "", "menuText": "", "conditions": "", "userScript": "", "outgoing": [415], "isPlayer": false, "isRoot": 0}, {"id": 3, "actorId": 95, "speaker": "Player_Romus", "title": "Player_Romus: \"\"The time for diplomacy has passed....\"", "dialogueText": "\"The time for diplomacy has passed. It is time for we Rizians to assert ourselves in the face of the Palesian aggressor.\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [35], "isPlayer": true, "isRoot": 0}, {"id": 4, "actorId": 95, "speaker": "Player_Romus", "title": "Player_Romus: \"\"With a heavy heart, I declare that...\"", "dialogueText": "\"With a heavy heart, I declare that war has descended upon us. And I call for your compassion.\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [27], "isPlayer": true, "isRoot": 0}, {"id": 5, "actorId": 95, "speaker": "Player_Romus", "title": "Player_Romus: \"\"Guided by divine providence, we en...\"", "dialogueText": "\"Guided by divine providence, we enter a war to protect our sacred values and the sanctity of our homeland.\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [27], "isPlayer": true, "isRoot": 0}, {"id": 6, "actorId": 95, "speaker": "Player_Romus", "title": "Player_Romus: \"\"It is with a sense of duty that I...\"", "dialogueText": "\"It is with a sense of duty that I announce a state of war, a necessary stance for Rizia's security and future.\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [27], "isPlayer": true, "isRoot": 0}, {"id": 7, "actorId": 95, "speaker": "Player_Romus", "title": "Player_Romus: \"\"Our independence is non-negotiable...\"", "dialogueText": "\"Our independence is non-negotiable. We will not be swayed by international pressures or superpower alliances.\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [34], "isPlayer": true, "isRoot": 0}, {"id": 8, "actorId": 95, "speaker": "Player_Romus", "title": "Player_Romus: \"\"My people, I have long yearned for...\"", "dialogueText": "\"My people, I have long yearned for the reunification of our lands, a dream that today becomes a solemn vow.\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [25], "isPlayer": true, "isRoot": 0}, {"id": 9, "actorId": 95, "speaker": "Player_Romus", "title": "Player_Romus: \"\"In the heart of every Rizian, ther...\"", "dialogueText": "\"In the heart of every Rizian, there lies a deep-seated desire to see our nation whole, undivided by foreign claims or unjust rulings.\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [30], "isPlayer": true, "isRoot": 0}, {"id": 10, "actorId": 95, "speaker": "Player_Romus", "title": "Player_Romus: \"\"This reunification is not merely a...\"", "dialogueText": "\"This reunification is not merely a quest for land, but a reclamation of the Rizian history and culture that is deeply intertwined with these territories.\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [32], "isPlayer": true, "isRoot": 0}, {"id": 11, "actorId": 95, "speaker": "Player_Romus", "title": "Player_Romus: \"\"As your King, I stand before you,...\"", "dialogueText": "\"As your King, I stand before you, not only as a leader but as a steward of our collective legacy, committed to restoring what is ours.\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [25], "isPlayer": true, "isRoot": 0}, {"id": 12, "actorId": 95, "speaker": "Player_Romus", "title": "Player_Romus: \"\"Today, it is the spirit of our anc...\"", "dialogueText": "\"Today, it is the spirit of our ancestors that guides us, their unfulfilled aspirations now our sacred mission.\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [25], "isPlayer": true, "isRoot": 0}, {"id": 13, "actorId": 95, "speaker": "Player_Romus", "title": "Player_Romus: \"\"The journey ahead is fraught with...\"", "dialogueText": "\"The journey ahead is fraught with challenges, but our resolve is fortified by the righteousness of our cause.\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [25], "isPlayer": true, "isRoot": 0}, {"id": 14, "actorId": 95, "speaker": "Player_Romus", "title": "Player_Romus: \"\"As we stand on the precipice of ch...\"", "dialogueText": "\"As we stand on the precipice of change, I ask you, my people, to hold fast to the belief that our future is one of prosperity and peace. Pales and Rizia will reunite under one banner.\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [24], "isPlayer": true, "isRoot": 0}, {"id": 15, "actorId": 95, "speaker": "Player_Romus", "title": "Player_Romus: \"\"The journey ahead is full of strug...\"", "dialogueText": "\"The journey ahead is full of struggle, pain, and death. But we have survived all of our past national struggles, and we will survive this one too.\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [31], "isPlayer": true, "isRoot": 0}, {"id": 16, "actorId": 95, "speaker": "Player_Romus", "title": "Player_Romus: \"\"I will say to you: The 'Grand Duch...\"", "dialogueText": "\"I will say to you: The 'Grand Duchy' has no legitimate claim to statehood. It belonged to Rizia once, and it will again.\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [26], "isPlayer": true, "isRoot": 0}, {"id": 17, "actorId": 95, "speaker": "Player_Romus", "title": "Player_Romus: \"\"As your king, I have to be honest...\"", "dialogueText": "\"As your king, I have to be honest with all of you. Everyone will have to do their part to win this war, and sacrifices will need to be made.\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [26], "isPlayer": true, "isRoot": 0}, {"id": 18, "actorId": 95, "speaker": "Player_Romus", "title": "Player_Romus: \"\"In our sacrifices, we find the see...\"", "dialogueText": "\"In our sacrifices, we find the seeds of our eventual triumph. Our shared hardships make us stronger.\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [24], "isPlayer": true, "isRoot": 0}, {"id": 19, "actorId": 95, "speaker": "Player_Romus", "title": "Player_Romus: \"\"Let us brace for the trials ahead,...\"", "dialogueText": "\"Let us brace for the trials ahead, knowing that each challenge we overcome is a step closer to our rightful destiny.\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [24], "isPlayer": true, "isRoot": 0}, {"id": 20, "actorId": 95, "speaker": "Player_Romus", "title": "Player_Romus: \"\"This century began with trials for...\"", "dialogueText": "\"This century began with trials for our people, yet we've endured. We will survive once again.\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [28], "isPlayer": true, "isRoot": 0}, {"id": 21, "actorId": 95, "speaker": "Player_Romus", "title": "Player_Romus: \"\"As long as they still have my daug...\"", "dialogueText": "\"As long as they still have my daughter, we will fight them to the very last breath.\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [28], "isPlayer": true, "isRoot": 0}, {"id": 22, "actorId": 95, "speaker": "Player_Romus", "title": "Player_Romus: \"\"From the Rezenid Empire through th...\"", "dialogueText": "\"From the Rezenid Empire through the present day, we are a people that not only survives, but thrives.\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [28], "isPlayer": true, "isRoot": 0}, {"id": 23, "actorId": 95, "speaker": "Player_Romus", "title": "Player_Romus: \"\"Guided by our faith, we march forw...\"", "dialogueText": "\"Guided by our faith, we march forward with divine conviction.\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [28], "isPlayer": true, "isRoot": 0}, {"id": 24, "actorId": 2, "speaker": "Paskal Beniwoll", "title": "//", "dialogueText": "", "menuText": "", "conditions": "", "userScript": "--;", "outgoing": [3, 4, 36, 6], "isPlayer": false, "isRoot": 0}, {"id": 25, "actorId": 2, "speaker": "Paskal Beniwoll", "title": "//", "dialogueText": "", "menuText": "", "conditions": "", "userScript": "--;", "outgoing": [10, 15, 16, 17], "isPlayer": false, "isRoot": 0}, {"id": 26, "actorId": 2, "speaker": "Paskal Beniwoll", "title": "//", "dialogueText": "", "menuText": "", "conditions": "", "userScript": "--;", "outgoing": [7, 14, 18, 19], "isPlayer": false, "isRoot": 0}, {"id": 27, "actorId": 2, "speaker": "Paskal Beniwoll", "title": "//", "dialogueText": "", "menuText": "", "conditions": "", "userScript": "--;", "outgoing": 