rn06_WarSpeech_Impact\"] = Variable[\"RiziaDLC.Turn06_WarSpeech_Impact\"] + 1;", "outgoing": [24], "isPlayer": false, "isRoot": 0}, {"id": 35, "actorId": 2, "speaker": "Paskal Beniwoll", "title": "RiziaDLC.Turn06_WarSpeech_Impact += 1;", "dialogueText": "", "menuText": "", "conditions": "", "userScript": "Variable[\"RiziaDLC.Turn06_WarSpeech_Impact\"] = Variable[\"RiziaDLC.Turn06_WarSpeech_Impact\"] + 1;", "outgoing": [27], "isPlayer": false, "isRoot": 0}, {"id": 36, "actorId": 2, "speaker": "Paskal Beniwoll", "title": "RiziaDLC.Trait_ReligiousKing == true", "dialogueText": "", "menuText": "", "conditions": "", "userScript": "", "outgoing": [37, 38], "isPlayer": false, "isRoot": 0}, {"id": 37, "actorId": 2, "speaker": "Paskal Beniwoll", "title": "RiziaDLC.Trait_ReligiousKing == true", "dialogueText": "", "menuText": "", "conditions": "Variable[\"RiziaDLC.Trait_ReligiousKing\"] == true", "userScript": "", "outgoing": [5], "isPlayer": false, "isRoot": 0}, {"id": 38, "actorId": 2, "speaker": "Paskal Beniwoll", "title": "!(RiziaDLC.Trait_ReligiousKing == true)", "dialogueText": "", "menuText": "", "conditions": "(Variable[\"RiziaDLC.Trait_ReligiousKing\"] == true) == false", "userScript": "", "outgoing": [], "isPlayer": false, "isRoot": 0}, {"id": 39, "actorId": 2, "speaker": "Paskal Beniwoll", "title": "RiziaDLC.Turn06_WarSpeech_EntireFamilyHighlighted = true", "dialogueText": "", "menuText": "", "conditions": "", "userScript": "Variable[\"RiziaDLC.Turn06_WarSpeech_EntireFamilyHighlighted\"] = true;", "outgoing": [77], "isPlayer": false, "isRoot": 0}, {"id": 40, "actorId": 2, "speaker": "Paskal Beniwoll", "title": "RiziaDLC.Turn06_WarSpeech_MotherEstelaHighlighted = true", "dialogueText": "", "menuText": "", "conditions": "", "userScript": "Variable[\"RiziaDLC.Turn06_WarSpeech_MotherEstelaHighlighted\"] = true;", "outgoing": [77], "isPlayer": false, "isRoot": 0}, {"id": 41, "actorId": 2, "speaker": "Paskal Beniwoll", "title": "RiziaDLC.Turn06_WarSpeech_VinaHighlighted = true", "dialogueText": "", "menuText": "", "conditions": "", "userScript": "Variable[\"RiziaDLC.Turn06_WarSpeech_VinaHighlighted\"] = true;", "outgoing": [77], "isPlayer": false, "isRoot": 0}, {"id": 42, "actorId": 2, "speaker": "Paskal Beniwoll", "title": "RiziaDLC.Turn06_WarSpeech_RomusAloneHighlighted = true", "dialogueText": "", "menuText": "", "conditions": "", "userScript": "Variable[\"RiziaDLC.Turn06_WarSpeech_RomusAloneHighlighted\"] = true;", "outgoing": [77], "isPlayer": false, "isRoot": 0}, {"id": 43, "actorId": 2, "speaker": "Paskal Beniwoll", "title": "RiziaDLC.Turn06_WarSpeech_HugoHiglighted = true", "dialogueText": "", "menuText": "", "conditions": "", "userScript": "Variable[\"RiziaDLC.Turn06_WarSpeech_HugoHiglighted\"] = true;", "outgoing": [77], "isPlayer": false, "isRoot": 0}, {"id": 44, "actorId": 95, "speaker": "Player_Romus", "title": "Player_Romus: \"\"Glovurius axa Rizia!\"\"", "dialogueText": "\"Glovurius axa Rizia!\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [99], "isPlayer": true, "isRoot": 0}, {"id": 45, "actorId": 95, "speaker": "Player_Romus", "title": "Player_Romus: \"\"For Honor, For Rizia, For Eternity!\"\"", "dialogueText": "\"For Honor, For Rizia, For Eternity!\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [91], "isPlayer": true, "isRoot": 0}, {"id": 46, "actorId": 95, "speaker": "Player_Romus", "title": "Player_Romus: \"\"Anchored in Gold!\"\"", "dialogueText": "\"Anchored in Gold!\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [91], "isPlayer": true, "isRoot": 0}, {"id": 47, "actorId": 95, "speaker": "Player_Romus", "title": "Player_Romus: \"\"United under the Crown, we stand s...\"", "dialogueText": "\"United under the Crown, we stand strong!\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [91], "isPlayer": true, "isRoot": 0}, {"id": 48, "actorId": 95, "speaker": "Player_Romus", "title": "Player_Romus: \"\"For king and country!\"\"", "dialogueText": "\"For king and country!\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [91], "isPlayer": true, "isRoot": 0}, {"id": 49, "actorId": 95, "speaker": "Player_Romus", "title": "Player_Romus: \"\"United we stand – a family, a king...\"", "dialogueText": "\"United we stand – a family, a kingdom, one force for the future of Rizia!\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [39], "isPlayer": true, "isRoot": 0}, {"id": 50, "actorId": 95, "speaker": "Player_Romus", "title": "Player_Romus: \"\"With the wisdom of the Grand Vizie...\"", "dialogueText": "\"With the wisdom of the Grand Vizier at my side, we march boldly into our shared destiny!\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [43], "isPlayer": true, "isRoot": 0}, {"id": 51, "actorId": 95, "speaker": "Player_Romus", "title": "Player_Romus: \"\"Beside me stands our future, Princ...\"", "dialogueText": "\"Beside me stands our future, Princess Vina – a beacon of strength and hope for Rizia.\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [41], "isPlayer": true, "isRoot": 0}, {"id": 52, "actorId": 95, "speaker": "Player_Romus", "title": "Player_Romus: \"\"With Queen Mother Estela, our matr...\"", "dialogueText": "\"With Queen Mother Estela, our matriarch, at my side, we carry forth the Rizian spirit.\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [40], "isPlayer": true, "isRoot": 0}, {"id": 53, "actorId": 95, "speaker": "Player_Romus", "title": "Player_Romus: \"\"Alone I stand, yet I am united wit...\"", "dialogueText": "\"Alone I stand, yet I am united with every Rizian heart – for our kingdom, for our people.\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [42], "isPlayer": true, "isRoot": 0}, {"id": 54, "actorId": 93, "speaker": "Player_Romus_Italic", "title": "Player_Romus_Italic: \"I raised my fist in the air.\"", "dialogueText": "I raised my fist in the air.", "menuText": "Raise f