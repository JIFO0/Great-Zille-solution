 "Variable[\"BaseGameIsolated.Debate_Enable_RemusHolstron\"] = true;", "outgoing": [9], "isPlayer": false, "isRoot": 0}, {"id": 25, "actorId": 15, "speaker": "Mansoun Leke", "title": "BaseGameIsolated.Debate_Enable_MansounLeke = true", "dialogueText": "", "menuText": "", "conditions": "", "userScript": "Variable[\"BaseGameIsolated.Debate_Enable_MansounLeke\"] = true;", "outgoing": [12], "isPlayer": false, "isRoot": 0}, {"id": 26, "actorId": 15, "speaker": "Mansoun Leke", "title": "BaseGameIsolated.Debate_Enable_LileasGraf = true", "dialogueText": "", "menuText": "", "conditions": "", "userScript": "Variable[\"BaseGameIsolated.Debate_Enable_LileasGraf\"] = true;", "outgoing": [27], "isPlayer": false, "isRoot": 0}, {"id": 27, "actorId": 10, "speaker": "Narrator", "title": "Narrator: \"The makeup girl dusted my cheeks wi...\"", "dialogueText": "The makeup girl dusted my cheeks with one last coat of powder as the lights in the Sordish Broadcasting Corporation studio flickered to life.", "menuText": "", "conditions": "", "userScript": "", "outgoing": [141], "isPlayer": false, "isRoot": 0}, {"id": 28, "actorId": 10, "speaker": "Narrator", "title": "Narrator: \"Back during the '53 election, I had...\"", "dialogueText": "Back during the '53 election, I had debated my political opponents on the radio. Now the debate was to be televised, like everything else these days.", "menuText": "", "conditions": "", "userScript": "", "outgoing": [29, 31], "isPlayer": false, "isRoot": 0}, {"id": 29, "actorId": 6, "speaker": "Player_Italic", "title": "Player_Italic: \"I pulled out a pocket mirror and lo...\"", "dialogueText": "I pulled out a pocket mirror and looked at my face. I didn't remember all those wrinkles being there four years ago.", "menuText": "Check your reflection.", "conditions": "", "userScript": "", "outgoing": [30], "isPlayer": true, "isRoot": 0}, {"id": 30, "actorId": 6, "speaker": "Player_Italic", "title": "Player_Italic: \"I took my place in one of the uncom...\"", "dialogueText": "I took my place in one of the uncomfortable wooden chairs next to the moderator's desk, beside the other presidential candidates.", "menuText": "Have a seat.", "conditions": "", "userScript": "", "outgoing": [32], "isPlayer": true, "isRoot": 0}, {"id": 31, "actorId": 6, "speaker": "Player_Italic", "title": "Player_Italic: \"I pulled a flask from out of my coa...\"", "dialogueText": "I pulled a flask from out of my coat pocket and took a quick nip.", "menuText": "Take a sip of something strong.", "conditions": "", "userScript": "", "outgoing": [30], "isPlayer": true, "isRoot": 0}, {"id": 32, "actorId": 10, "speaker": "Narrator", "title": "Narrator: \"The moderator walked in and sat at...\"", "dialogueText": "The moderator walked in and sat at her desk. I recognized her as a former SBC reporter I'd encountered on a number of occasions. She nodded to me and the others.", "menuText": "", "conditions": "", "userScript": "", "outgoing": [33], "isPlayer": false, "isRoot": 0}, {"id": 33, "actorId": 12, "speaker": "Moderator", "title": "Moderator: \"\"We'll begin in just a few minutes....\"", "dialogueText": "\"We'll begin in just a few minutes. I'm looking forward to an evening of polite and civil discourse.\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [38, 39, 35], "isPlayer": false, "isRoot": 0}, {"id": 34, "actorId": 5, "speaker": "Player", "title": "Player: \"\"Just don't forget who you work for.\"\"", "dialogueText": "\"Just don't forget who you work for.\"", "menuText": "\"Just don't forget who you work for.\"", "conditions": "", "userScript": "", "outgoing": [40], "isPlayer": true, "isRoot": 0}, {"id": 35, "actorId": 15, "speaker": "Mansoun Leke", "title": "BaseGame.Media_Censored == true || BaseGame.Media_SordlandToday_Bias == true", "dialogueText": "", "menuText": "", "conditions": "", "userScript": "", "outgoing": [36, 37], "isPlayer": false, "isRoot": 0}, {"id": 36, "actorId": 15, "speaker": "Mansoun Leke", "title": "BaseGame.Media_Censored == true || BaseGame.Media_SordlandToday_Bias == true", "dialogueText": "", "menuText": "", "conditions": "Variable[\"BaseGame.Media_Censored\"] == true  or  Variable[\"BaseGame.Media_SordlandToday_Bias\"] == true", "userScript": "", "outgoing": [34], "isPlayer": false, "isRoot": 0}, {"id": 37, "actorId": 15, "speaker": "Mansoun Leke", "title": "!(BaseGame.Media_Censored == true || BaseGame.Media_SordlandToday_Bias == true)", "dialogueText": "", "menuText": "", "conditions": "(Variable[\"BaseGame.Media_Censored\"] == true  or  Variable[\"BaseGame.Media_SordlandToday_Bias\"] == true) == false", "userScript": "", "outgoing": [], "isPlayer": false, "isRoot": 0}, {"id": 38, "actorId": 5, "speaker": "Player", "title": "Player: \"\"One can only hope.\"\"", "dialogueText": "\"One can only hope.\"", "menuText": "\"One can only hope.\"", "conditions": "", "userScript": "", "outgoing": [41], "isPlayer": true, "isRoot": 0}, {"id": 39, "actorId": 5, "speaker": "Player", "title": "Player: \"\"Ha. Where's the fun in that?\"\"", "dialogueText": "\"Ha. Where's the fun in that?\"", "menuText": "\"Ha. Where's the fun in that?\"", "conditions": "", "userScript": "", "outgoing": [40], "isPlayer": true, "isRoot": 0}, {"id": 40, "actorId": 10, "speaker": "Narrator", "title": "Narrator: \"She forced a smile before turning b...\"", "dialogueText": "She forced a smile before turning back towards the cameras. After a quick countdown, we were live.", "menuText": "", "conditions": "", "userScript": "", "outgoing": [42], "isPlayer": false, "isRoot": 0}, {"id": 41, "actorId": 10, "speaker": "Narrator", "title": "Narrator: \"She smiled at me gratefully before...\"", "dialogueText": "She smiled at me gratefully before turning back towards the cameras. After a quick countdown, we were live.", "menuText": "", "conditions": "", "userScript": "", "outgoing": [42], "isPlayer": false, "isRoot": 0}, {"id": 42, "actorId": 12, "speaker": "Moderator", "title": "Moderator: \"\"Good evening, ladies and gentlemen...\"", "dialogueText": "\"Good evening, ladies and gentlemen. The Sordish Broadcasting Company is pleased to welcome all candidates in the 1957 Sordish presidential election.\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [43], "isPlayer": false, "isRoot": 0}, {"id": 43, "actorId": 12, "speaker": "Moderator", "title": "Moderator: \"\"To my left is Anton Rayne, the inc...\"", "dialogueText": "\"To my left is Anton Rayne, the incumbent president of Sordland.\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [44, 45, 46], "isPlayer": false, "isRoot": 0}, {"id": 44, "actorId": 5, "speaker": "Player", "title": "Player: \"\"Glad to be here.\"\"", "dialogueText": "\"Glad to be here.\"", "menuText": "\"Glad to be here.\"", "conditions": "", "userScript": "", "outgoing": [48], "isPlayer": true, "isRoot": 0}, {"id": 45, "actorId": 5, "speaker": "Player", "title": "Player: \"\"A Morgna wes core!\"\"", "dialogueText": "\"A Morgna wes core!\"", "menuText": "\"A Morgna wes core!\"", "conditions": "", "userScript": "", "outgoing": [132], "isPlayer": true, "isRoot": 0}, {"id": 46, "actorId": 6, "speaker": "Player_Italic", "title": "Player_Italic: \"I kept my mouth shut.\"", "dialogueText": "I kept my mouth shut.", "menuText": "Say nothing.", "conditions": "", "userScript": "", "outgoing": [48], "isPlayer": true, "isRoot": 0}, {"id": 47, "actorId": 10, "speaker": "Narrator", "title": "Narrator: \"He and Mansoun exchanged nods.\"", "dialogueText": "He and Mansoun exchanged nods.", "menuText": "", "conditions": "", "userScript": "", "outgoing": [89], "isPlayer": false, "isRoot": 0}, {"id": 48, "actorId": 15, "speaker": "Mansoun Leke", "title": "BaseGameIsolated.Debate_Enable_LileasGraf == true", "dialogueText": "", "menuText": "", "conditions": "", "userScript": "", "outgoing": [49, 50], "isPlayer": false, "isRoot": 0}, {"id": 49, "actorId": 15, "speaker": "Mansoun Leke", "title": "BaseGameIsolated.Debate_Enable_LileasGraf == true", "dialogueText": "", "menuText": "", "conditions": "Variable[\"BaseGameIsolated.Debate_Enable_LileasGraf\"] == true", "userScript": "", "outgoing": [62], "isPlayer": false, "isRoot": 0}, {"id": 50, "actorId": 15, "speaker": "Mansoun Leke", "title": "!(BaseGameIsolated.Debate_Enable_LileasGraf == true)", "dialogueText": "", "menuText": "", "conditions": "(Variable[\"BaseGameIsolated.Debate_Enable_LileasGraf\"] == true) == false", "userScript": "", "outgoing": [54], "isPlayer": false, "isRoot": 0}, {"id": 51, "actorId": 15, "speaker": "Mansoun Leke", "title": "BaseGameIsolated.Debate_Enable_MansounLeke == true", "dialogueText": "", "menuText": "", "conditions": "", "userScript": "", "outgoing": [52, 53], "isPlayer": false, "isRoot": 0}, {"id": 52, "actorId": 15, "speaker": "Mansoun Leke", "title": "BaseGameIsolated.Debate_Enable_MansounLeke == true", "dialogueText": "", "menuText": "", "conditions": "Variable[\"BaseGameIsolated.Debate_Enable_MansounLeke\"] == true", "userScript": "", "outgoing": [68], "isPlayer": false, "isRoot": 0}, {"id": 53, "actorId": 15, "speaker": "Mansoun Leke", "title": "!(BaseGameIsolated.Debate_Enable_MansounLeke == true)", "dialogueText": "", "menuText": "", "conditions": "(Variable[\"BaseGameIsolated.Debate_Enable_MansounLeke\"] == true) == false", "userScript": "", "outgoing": [66], "isPlayer": false, "isRoot": 0}, {"id": 54, "actorId": 15, "speaker": "Mansoun Leke", "title": "BaseGameIsolated.Debate_Enable_FrensRicter == true", "dialogueText": "", "menuText": "", "conditions": "", "userScript": "", "outgoing": [55, 56], "isPlayer": false, "isRoot": 0}, {"id": 55, "actorId": 15, "speaker": "Mansoun Leke", "title": "BaseGameIsolated.Debate_Enable_FrensRicter == true", "dialogueText": "", "menuText": "", "conditions": "Variable[\"BaseGameIsolated.Debate_Enable_FrensRicter\"] == true", "userScript": "", "outgoing": [67], "isPlayer": false, "isRoot": 0}, {"id": 56, "actorId": 15, "speaker": "Mansoun Leke", "title": "!(BaseGameIsolated.Debate_Enable_FrensRicter == true)", "dialogueText": "", "menuText": "", "conditions": "(Variable[\"BaseGameIsolated.Debate_Enable_FrensRicter\"] == true) == false", "userScript": "", "outgoing": [136], "isPlayer": false, "isRoot": 0}, {"id": 57, "actorId": 15, "speaker": "Mansoun Leke", "title": "BaseGameIsolated.Debate_Enable_KesaroKibener == true", "dialogueText": "", "menuText": "", "conditions": "", "userScript": "", "outgoing": [58, 59], "isPlayer": false, "isRoot": 0}, {"id": 58, "actorId": 15, "speaker": "Mansoun Leke", "title": "BaseGameIsolated.Debate_Enable_KesaroKibener == true", "dialogueText": "", "menuText": "", "conditions": "Variable[\"BaseGameIsolated.Debate_Enable_KesaroKibener\"] == true", "userScript": "", "outgoing": [60], "isPlayer": false, "isRoot": 0}, {"id": 59, "actorId": 15, "speaker": "Mansoun Leke", "title": "!(BaseGameIsolated.Debate_Enable_KesaroKibener == true)", "dialogueText": "", "menuText": "", "conditions": "(Variable[\"BaseGameIsolated.Debate_Enable_KesaroKibener\"] == true) == false", "userScript": "", "outgoing": [70], "isPlayer": false, "isRoot": 0}, {"id": 60, "actorId": 12, "speaker": "Moderator", "title": "Moderator: \"\"Kesaro Kibener, leader of the NFP.\"\"", "dialogueText": "\"Kesaro Kibener, leader of the NFP.\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [76], "isPlayer": false, "isRoot": 0}, {"id": 61, "actorId": 22, "speaker": "Denis Stahler", "title": "Denis Stahler: \"\"That's right. The President may ha...\"", "dialogueText": "\"That's right. The President may have tried to silence me, but he couldn't silence our movement. The poor and downtrodden of Sordland *will* unite and rise up.\"", "menuText": "", "conditions": "", "userScript": "", "outgoing": [82], "isPlayer": false, "isRoot": 0}, {"id": 62, "actorId": 12, "speaker": "Moderator", "title": "Moderator: \"\"To my right, Lileas Graf, former I...\"", "dialogueText": "\"To my right, Lileas Graf, former Interior Minister and leader of the U